                android:value="Maintains WeCom connection for remote SMS commands" />
        </service>

        <service
            android:name=".services.EmailRemoteControlService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Maintains Email IMAP poller for remote SMS commands" />
        </service>

        <service
            android:name=".services.TelegramRemoteControlService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
