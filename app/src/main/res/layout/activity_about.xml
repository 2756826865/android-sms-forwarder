<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/miui_page_background">

    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/about_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/miui_page_background">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/about_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/miui_page_background"
            app:navigationIconTint="@color/miui_primary_text"
            app:title="" />
    </org.fossify.commons.views.MyAppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="30dp"
            android:text="@string/about"
            android:textColor="@color/miui_primary_text"
            android:textSize="38sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/settings_card_background"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <TextView android:id="@+id/about_common_questions" android:layout_width="match_parent" android:layout_height="66dp" android:drawableEnd="@drawable/ic_chevron_right_vector" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:paddingHorizontal="20dp" android:text="@string/about_common_questions" android:textColor="@color/miui_primary_text" android:textSize="18sp" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="20dp" android:background="@color/miui_divider" />
            <TextView android:id="@+id/about_known_issues" android:layout_width="match_parent" android:layout_height="66dp" android:drawableEnd="@drawable/ic_chevron_right_vector" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:paddingHorizontal="20dp" android:text="@string/about_known_issues" android:textColor="@color/miui_primary_text" android:textSize="18sp" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="20dp" android:background="@color/miui_divider" />
            <TextView android:id="@+id/about_licenses" android:layout_width="match_parent" android:layout_height="66dp" android:drawableEnd="@drawable/ic_chevron_right_vector" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:paddingHorizontal="20dp" android:text="@string/about_licenses" android:textColor="@color/miui_primary_text" android:textSize="18sp" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="20dp" android:background="@color/miui_divider" />
            <TextView android:id="@+id/about_version" android:layout_width="match_parent" android:layout_height="76dp" android:gravity="center_vertical" android:paddingHorizontal="20dp" android:textColor="@color/miui_primary_text" android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
