<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settings_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/miui_page_background"
    android:orientation="vertical">

    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/settings_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/miui_page_background"
        android:elevation="0dp"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/settings_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/miui_page_background"
            app:background="@color/miui_page_background"
            app:navigationIconTint="@color/miui_primary_text"
            app:title="@string/settings_messages_title"
            app:titleTextColor="@color/miui_primary_text" />
    </org.fossify.commons.views.MyAppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/settings_nested_scrollview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="28dp">

        <LinearLayout
            android:id="@+id/settings_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="18dp"
            android:paddingEnd="16dp">

            <TextView
                style="@style/SmsSettingsSectionTitle"
                android:layout_marginStart="16dp"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="8dp"
                android:text="@string/settings_functions" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/settings_card_background"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/settings_forwarding_holder"
                    style="@style/SmsSettingsRow"
                    android:text="@string/settings_forwarding" />

                <TextView
                    android:id="@+id/settings_template_holder"
                    style="@style/SmsSettingsRow"
                    android:text="消息模板" />

                <TextView
                    android:id="@+id/settings_scheduled_holder"
                    style="@style/SmsSettingsRow"
                    android:text="@string/scheduled_management" />

                <TextView
                    android:id="@+id/settings_bulk_send_holder"
                    style="@style/SmsSettingsRow"
                    android:text="@string/bulk_send" />

                <TextView
                    android:id="@+id/settings_low_battery_holder"
                    style="@style/SmsSettingsRow"
                    android:text="@string/low_battery_reminder" />
            </LinearLayout>

            <TextView
                style="@style/SmsSettingsSectionTitle"
                android:layout_marginStart="16dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="@string/settings_system" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/settings_card_background"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/settings_sync_holder"
                    style="@style/SmsSettingsRow"
                    android:text="@string/settings_sync" />

                <TextView
                    android:id="@+id/settings_compatibility_holder"
                    style="@style/SmsSettingsRow"
                    android:text="@string/compatibility_title" />

                <TextView
                    android:id="@+id/settings_blocking_holder"
                    style="@style/SmsSettingsRow"
                    android:text="@string/settings_blocking" />

                <TextView
                    android:id="@+id/settings_recently_deleted_holder"
                    style="@style/SmsSettingsRow"
                    android:text="@string/settings_recently_deleted" />

                <LinearLayout
                    android:id="@+id/settings_home_bottom_nav_holder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="64dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:text="@string/settings_home_bottom_nav"
                            android:textColor="@color/miui_primary_text"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="sans-serif"
                            android:text="@string/settings_home_bottom_nav_summary"
                            android:textColor="@color/miui_secondary_text"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/settings_home_bottom_nav_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/settings_home_list_density_holder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="64dp"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="@string/settings_home_list_density"
                        android:textColor="@color/miui_primary_text"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/settings_home_list_density_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/miui_secondary_text"
                        android:textSize="13sp"
                        tools:text="调节会话列表疏密，约一屏显示 8 条" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/settings_live_island_holder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="64dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:text="@string/settings_live_island"
                            android:textColor="@color/miui_primary_text"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/settings_live_island_summary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="sans-serif"
                            android:text="@string/live_island_status_disabled"
                            android:textColor="@color/miui_secondary_text"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/settings_live_island_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/SmsSettingsSectionTitle"
                android:layout_marginStart="16dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="@string/settings_other" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/settings_card_background"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/settings_about_holder"
                    style="@style/SmsSettingsRow"
                    android:text="@string/about" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
