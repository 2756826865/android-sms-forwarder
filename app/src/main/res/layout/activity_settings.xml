<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/miui_page_background">

    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/settings_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/miui_page_background">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/settings_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/miui_page_background"
            app:navigationIconTint="@color/miui_primary_text"
            app:title="" />
    </org.fossify.commons.views.MyAppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/settings_nested_scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="28dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/settings_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:id="@+id/settings_large_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="30dp"
                android:fontFamily="sans-serif"
                android:text="@string/settings_messages_title"
                android:textColor="@color/miui_primary_text"
                android:textSize="38sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif"
                android:text="@string/settings_functions"
                android:textColor="@color/miui_section_text"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/settings_card_background"
                android:orientation="vertical"
                android:paddingVertical="4dp">

                <TextView
                    android:id="@+id/settings_forwarding_holder"
                    style="@style/SmsSettingsRow"
                    android:text="@string/settings_forwarding" />

                <View style="@style/SmsSettingsDivider" />

                <TextView
                    android:id="@+id/settings_scheduled_holder"
                    style="@style/SmsSettingsRow"
                    android:text="@string/scheduled_management" />

                <View style="@style/SmsSettingsDivider" />

                <TextView
                    android:id="@+id/settings_bulk_send_holder"
                    style="@style/SmsSettingsRow"
                    android:text="@string/bulk_send" />

                <View style="@style/SmsSettingsDivider" />

                <LinearLayout
                    android:id="@+id/settings_batch_delay_holder"
                    android:layout_width="match_parent"
                    android:layout_height="82dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:text="@string/settings_batch_delay"
                            android:textColor="@color/miui_primary_text"
                            android:textSize="18sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif"
                            android:text="@string/settings_batch_delay_summary"
                            android:textColor="@color/miui_secondary_text"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/settings_batch_delay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableEnd="@drawable/ic_chevron_right_vector"
                        android:drawablePadding="8dp"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/miui_secondary_text"
                        android:textSize="15sp" />
                </LinearLayout>

                <View style="@style/SmsSettingsDivider" />

                <TextView
                    android:id="@+id/settings_blocking_holder"
                    style="@style/SmsSettingsRow"
                    android:text="@string/settings_blocking" />

                <View style="@style/SmsSettingsDivider" />

                <TextView
                    android:id="@+id/settings_recently_deleted_holder"
                    style="@style/SmsSettingsRow"
                    android:text="@string/settings_recently_deleted" />

                <View style="@style/SmsSettingsDivider" />

                <LinearLayout
                    android:id="@+id/settings_sync_holder"
                    android:layout_width="match_parent"
                    android:layout_height="82dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:text="@string/settings_sync"
                            android:textColor="@color/miui_primary_text"
                            android:textSize="18sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif"
                            android:text="@string/settings_sync_summary"
                            android:textColor="@color/miui_secondary_text"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right_vector" />
                </LinearLayout>

                <View style="@style/SmsSettingsDivider" />

                <TextView
                    android:id="@+id/settings_compatibility_holder"
                    style="@style/SmsSettingsRow"
                    android:text="@string/compatibility_title" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="26dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif"
                android:text="@string/settings_other"
                android:textColor="@color/miui_section_text"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/settings_card_background"
                android:orientation="vertical"
                android:paddingVertical="4dp">

                <TextView
                    android:id="@+id/settings_about_holder"
                    style="@style/SmsSettingsRow"
                    android:text="@string/about" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
