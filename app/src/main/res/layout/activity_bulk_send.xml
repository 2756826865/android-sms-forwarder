<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/miui_page_background">

    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/bulk_send_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/bulk_send_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/miui_page_background"
            app:navigationIconTint="@color/miui_primary_text"
            app:title="" />
    </org.fossify.commons.views.MyAppBarLayout>

    <LinearLayout
        android:id="@+id/bulk_send_holder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/miui_page_background"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/home_horizontal_margin"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:text="@string/bulk_send"
            android:textColor="@color/miui_primary_text"
            android:textSize="@dimen/bulk_title_size" />

        <org.fossify.commons.views.MyEditText
            android:id="@+id/bulk_send_search"
            android:layout_width="match_parent"
            android:layout_height="@dimen/home_search_height"
            android:layout_marginHorizontal="@dimen/bulk_content_margin"
            android:background="@drawable/home_search_background"
            android:drawableStart="@drawable/ic_search_vector"
            android:drawablePadding="10dp"
            android:hint="@string/bulk_send_search"
            android:inputType="phone"
            android:paddingHorizontal="18dp"
            android:textColor="@color/miui_primary_text"
            android:textColorHint="@color/miui_hint_text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/bulk_content_margin"
            android:layout_marginTop="8dp"
            android:background="@drawable/bulk_field_background"
            android:orientation="vertical">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/bulk_send_import_file"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="start|center_vertical"
                android:text="@string/bulk_send_import_file"
                android:textColor="@color/miui_action_blue" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/bulk_send_add_number"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="start|center_vertical"
                android:text="@string/bulk_send_add_number_preview"
                android:textColor="@color/miui_action_blue"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/bulk_content_margin"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bulk_send_select_all"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/bulk_send_select_all"
                android:textColor="@color/miui_primary_text"
                app:cornerRadius="@dimen/bulk_field_radius"
                app:strokeColor="@color/bulk_outline" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bulk_send_clear"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/bulk_send_clear"
                android:textColor="@color/miui_primary_text"
                app:cornerRadius="@dimen/bulk_field_radius"
                app:strokeColor="@color/bulk_outline" />
        </LinearLayout>

        <TextView
            android:id="@+id/bulk_send_selected_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/home_horizontal_margin"
            android:paddingVertical="6dp"
            android:text="@string/bulk_send_selected_zero"
            android:textColor="@color/miui_secondary_text"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/bulk_send_recipients"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingHorizontal="12dp"
            android:paddingBottom="8dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/bulk_content_margin"
            android:layout_marginTop="4dp"
            android:background="@drawable/bulk_field_background"
            android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingTop="12dp" android:paddingEnd="16dp" android:text="@string/bulk_send_sim" android:textColor="@color/miui_section_text" android:textSize="12sp" />
            <Spinner android:id="@+id/bulk_send_sim" android:layout_width="match_parent" android:layout_height="48dp" android:contentDescription="@string/bulk_send_sim" android:paddingHorizontal="16dp" />
        </LinearLayout>

        <org.fossify.commons.views.MyEditText
            android:id="@+id/bulk_send_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/bulk_content_margin"
            android:layout_marginTop="8dp"
            android:background="@drawable/bulk_field_background"
            android:hint="@string/bulk_send_message"
            android:gravity="top|start"
            android:inputType="textCapSentences|textMultiLine"
            android:maxHeight="140dp"
            android:minHeight="80dp"
            android:padding="16dp"
            android:textColor="@color/miui_primary_text"
            android:textColorHint="@color/miui_hint_text" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="@dimen/home_horizontal_margin" android:paddingTop="7dp" android:text="@string/bulk_send_cost_notice" android:textColor="@color/miui_secondary_text" android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bulk_send_action"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_margin="12dp"
            android:text="@string/bulk_send_action"
            android:textColor="@android:color/white"
            app:backgroundTint="@color/miui_fab_green"
            app:cornerRadius="24dp" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
