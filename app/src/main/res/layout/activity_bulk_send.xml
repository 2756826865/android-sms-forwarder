<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/bulk_send_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/bulk_send_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/miui_page_background"
            app:title=""
            app:navigationIconTint="#111111"
            app:titleTextColor="#111111" />
    </org.fossify.commons.views.MyAppBarLayout>

    <LinearLayout
        android:id="@+id/bulk_send_holder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/miui_page_background"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="22dp"
            android:text="@string/bulk_send"
            android:textColor="@color/miui_primary_text"
            android:textSize="35sp" />

        <org.fossify.commons.views.MyEditText
            android:id="@+id/bulk_send_search"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/message_input_background"
            android:hint="@string/bulk_send_search"
            android:inputType="phone"
            android:paddingHorizontal="18dp"
            android:textColor="#111111"
            android:textColorHint="#8A8A8A" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bulk_send_add_number"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="16dp"
            android:text="@string/bulk_send_add_number_preview"
            android:textColor="#159447"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bulk_send_select_all"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/bulk_send_select_all"
                android:textColor="#222222"
                app:cornerRadius="18dp"
                app:strokeColor="#D5D5D5" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bulk_send_clear"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/bulk_send_clear"
                android:textColor="#222222"
                app:cornerRadius="18dp"
                app:strokeColor="#D5D5D5" />
        </LinearLayout>

        <TextView
            android:id="@+id/bulk_send_selected_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="@string/bulk_send_selected_zero"
            android:textColor="#555555" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/bulk_send_recipients"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <Spinner
            android:id="@+id/bulk_send_sim"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:contentDescription="@string/bulk_send_sim"
            android:paddingHorizontal="16dp" />

        <org.fossify.commons.views.MyEditText
            android:id="@+id/bulk_send_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/bulk_send_message"
            android:inputType="textCapSentences|textMultiLine"
            android:maxHeight="140dp"
            android:minHeight="72dp"
            android:padding="16dp"
            android:textColor="#111111"
            android:textColorHint="#777777" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="1"
            android:paddingHorizontal="16dp"
            android:text="@string/bulk_send_cost_notice"
            android:textColor="#666666"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bulk_send_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:text="@string/bulk_send_action"
            android:textColor="@android:color/white"
            app:backgroundTint="@color/miui_fab_green"
            app:cornerRadius="22dp" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
