<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/miui_page_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/heartbeat_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/miui_page_background"
        app:navigationIconTint="@color/miui_primary_text"
        app:title="定时心跳与状态保活"
        app:titleTextColor="@color/miui_primary_text" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="36dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp">

            <!-- 1. 总开关 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/settings_card_background"
                android:orientation="vertical"
                android:padding="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:text="启用定时状态报活"
                        android:textColor="@color/miui_primary_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/heartbeat_switch_enabled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true" />
                </RelativeLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="按设定的周期自动上报电量、网络、卡槽、运行时间等系统健康报告，确保备用机在线"
                    android:textColor="@color/miui_secondary_text"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 2. 周期配置 -->
            <TextView
                style="@style/SmsSettingsSectionTitle"
                android:layout_marginTop="16dp"
                android:text="上报周期" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/settings_card_background"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/heartbeat_interval_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="当前周期：每 12 小时一次"
                    android:textColor="@color/miui_primary_text"
                    android:textSize="15sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/heartbeat_interval_slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:stepSize="1"
                    android:value="12"
                    android:valueFrom="1"
                    android:valueTo="24" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="支持 1 ~ 24 小时间隔。推荐设置为 12 小时或 24 小时（每天定时一次）。"
                    android:textColor="@color/miui_secondary_text"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 3. 在线测试 -->
            <TextView
                style="@style/SmsSettingsSectionTitle"
                android:layout_marginTop="16dp"
                android:text="在线测试" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/settings_card_background"
                android:orientation="vertical"
                android:padding="16dp">

                <Button
                    android:id="@+id/heartbeat_btn_test"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="立即生成并发送一条状态报活" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="3dp"
                    android:text="说明：\n1. 报活将自动推送到您在「转发通道」中已开启的所有渠道。\n2. 基于 Android 标准 WorkManager 周期任务调度，纯本地运行，不占用系统前台资源。"
                    android:textColor="@color/miui_secondary_text"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
