<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/miui_card_background"
    android:clipChildren="false"
    android:clipToPadding="false">

    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/main_appbar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/main_menu"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/miui_card_background"
            app:titleTextColor="@color/miui_primary_text" />
    </org.fossify.commons.views.MyAppBarLayout>

    <LinearLayout
        android:id="@+id/home_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/home_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/miui_card_background"
            android:orientation="vertical"
            android:paddingStart="@dimen/home_horizontal_margin"
            android:paddingEnd="@dimen/home_horizontal_margin"
            android:paddingBottom="16dp">

            <LinearLayout
                android:id="@+id/selection_top_row"
                android:layout_width="match_parent"
                android:layout_height="@dimen/home_action_size"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/selection_close"
                    android:layout_width="@dimen/home_action_size"
                    android:layout_height="@dimen/home_action_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@android:string/cancel"
                    android:padding="13dp"
                    android:src="@drawable/ic_cross_vector"
                    app:tint="@color/miui_primary_text" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/selection_select_all"
                    android:layout_width="@dimen/home_action_size"
                    android:layout_height="@dimen/home_action_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/bulk_send_select_all"
                    android:padding="12dp"
                    android:src="@drawable/ic_select_all_vector"
                    app:tint="@color/miui_primary_text" />
            </LinearLayout>

            <TextView
                android:id="@+id/selection_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif"
                android:textColor="@color/miui_primary_text"
                android:textSize="@dimen/home_title_size"
                android:visibility="gone"
                tools:text="已选择 3 项" />

            <LinearLayout
                android:id="@+id/home_normal_top_row"
                android:layout_width="match_parent"
                android:layout_height="@dimen/home_action_size"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/home_mark_all_read"
                    android:layout_width="@dimen/home_action_size"
                    android:layout_height="@dimen/home_action_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/mark_all_read"
                    android:padding="13dp"
                    android:src="@drawable/ic_check_double_vector"
                    app:tint="@color/miui_primary_text" />

                <ImageButton
                    android:id="@+id/home_settings"
                    android:layout_width="@dimen/home_action_size"
                    android:layout_height="@dimen/home_action_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/settings"
                    android:padding="13dp"
                    android:src="@drawable/ic_settings_cog_vector"
                    app:tint="@color/miui_primary_text" />
            </LinearLayout>

            <TextView
                android:id="@+id/home_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:text="@string/home_primary"
                android:textColor="@color/miui_primary_text"
                android:textSize="@dimen/home_title_size" />

            <org.fossify.commons.views.MyEditText
                android:id="@+id/home_search"
                android:layout_width="match_parent"
                android:layout_height="@dimen/home_search_height"
                android:layout_marginTop="8dp"
                android:background="@drawable/home_search_background"
                android:drawableStart="@drawable/ic_search_vector"
                android:drawablePadding="12dp"
                android:fontFamily="sans-serif"
                android:hint="@string/home_search_sms"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="18dp"
                android:textColor="@color/miui_primary_text"
                android:textColorHint="@color/miui_hint_text"
                android:textSize="17sp" />
        </LinearLayout>

        <RelativeLayout
            android:id="@+id/main_coordinator_wrapper"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <RelativeLayout
                android:id="@+id/main_nested_scrollview"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <RelativeLayout
                    android:id="@+id/main_holder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent">

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/conversations_progress_bar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:indeterminate="true"
                        android:visibility="gone"
                        app:hideAnimationBehavior="outward"
                        app:showAnimationBehavior="inward"
                        app:showDelay="250"
                        tools:visibility="visible" />

                    <LinearLayout
                        android:id="@+id/empty_state"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="32dp">

                        <org.fossify.commons.views.MyTextView
                            android:id="@+id/no_conversations_placeholder"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/no_conversations_found"
                            android:textColor="@color/miui_secondary_text"
                            android:textSize="20sp"
                            android:visibility="gone" />

                        <org.fossify.commons.views.MyTextView
                            android:id="@+id/no_conversations_placeholder_2"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/ripple_all_corners"
                            android:gravity="center"
                            android:paddingHorizontal="20dp"
                            android:text="@string/start_conversation"
                            android:textSize="16sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <com.qtalk.recyclerviewfastscroller.RecyclerViewFastScroller
                        android:id="@+id/conversations_fastscroller"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <org.fossify.commons.views.MyRecyclerView
                            android:id="@+id/conversations_list"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clipToPadding="true"
                            android:layoutAnimation="@anim/layout_animation"
                            android:overScrollMode="ifContentScrolls"
                            android:paddingBottom="@dimen/home_content_bottom_padding"
                            android:scrollbars="none"
                            app:layoutManager="org.fossify.commons.views.MyLinearLayoutManager" />
                    </com.qtalk.recyclerviewfastscroller.RecyclerViewFastScroller>
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/search_holder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0"
                    android:background="@android:color/transparent"
                    android:visibility="gone">

                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/search_placeholder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/activity_margin"
                        android:text="@string/no_items_found"
                        android:textColor="@color/miui_secondary_text"
                        android:textSize="@dimen/bigger_text_size" />

                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/search_placeholder_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/search_placeholder"
                        android:gravity="center"
                        android:padding="@dimen/medium_margin"
                        android:text="@string/type_2_characters"
                        android:textColor="@color/miui_secondary_text"
                        android:textSize="@dimen/normal_text_size" />

                    <org.fossify.commons.views.MyRecyclerView
                        android:id="@+id/search_results_list"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="true"
                        android:paddingBottom="@dimen/home_content_bottom_padding"
                        android:scrollbars="vertical"
                        app:layoutManager="org.fossify.commons.views.MyLinearLayoutManager" />
                </RelativeLayout>
            </RelativeLayout>
        </RelativeLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/home_bottom_navigation"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/bottom_nav_height"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="@dimen/home_bottom_nav_bottom_margin"
        android:background="@drawable/home_bottom_nav_background"
        android:elevation="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="@dimen/home_bottom_nav_inner_padding"
        android:translationZ="16dp"
        android:visibility="visible">

            <FrameLayout
                android:layout_width="@dimen/home_bottom_nav_slot_width"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/home_nav_primary"
                    android:layout_width="@dimen/home_bottom_nav_item_width"
                    android:layout_height="@dimen/home_bottom_nav_item_height"
                    android:layout_gravity="center"
                    android:background="@drawable/home_bottom_nav_item_background"
                    android:drawableTop="@drawable/ic_home_messages_vector"
                    android:drawablePadding="-4dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/bottom_nav_primary"
                    android:textColor="@color/home_bottom_nav_tint"
                    android:textSize="11sp"
                    app:drawableTint="@color/home_bottom_nav_tint" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="@dimen/home_bottom_nav_slot_width"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/home_nav_forward"
                    android:layout_width="@dimen/home_bottom_nav_item_width"
                    android:layout_height="@dimen/home_bottom_nav_item_height"
                    android:layout_gravity="center"
                    android:background="@drawable/home_bottom_nav_item_background"
                    android:drawableTop="@drawable/ic_forwarding_vector"
                    android:drawablePadding="-4dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/bottom_nav_forward"
                    android:textColor="@color/home_bottom_nav_tint"
                    android:textSize="11sp"
                    app:drawableTint="@color/home_bottom_nav_tint" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="@dimen/home_bottom_nav_slot_width"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/home_nav_settings"
                    android:layout_width="@dimen/home_bottom_nav_item_width"
                    android:layout_height="@dimen/home_bottom_nav_item_height"
                    android:layout_gravity="center"
                    android:background="@drawable/home_bottom_nav_item_background"
                    android:drawableTop="@drawable/ic_settings_cog_vector"
                    android:drawablePadding="-4dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/bottom_nav_settings"
                    android:textColor="@color/home_bottom_nav_tint"
                    android:textSize="11sp"
                    app:drawableTint="@color/home_bottom_nav_tint" />
            </FrameLayout>
    </LinearLayout>

    <org.fossify.commons.views.MyFloatingActionButton
        android:id="@+id/conversations_fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/home_horizontal_margin"
        android:layout_marginBottom="@dimen/home_fab_bottom_margin"
        android:contentDescription="@string/new_conversation"
        android:src="@drawable/ic_plus_vector"
        app:backgroundTint="@color/home_fab_light_green"
        app:fabCustomSize="@dimen/home_fab_size"
        app:shapeAppearanceOverlay="@style/CircularFabShape"
        app:tint="@android:color/white" />

    <LinearLayout
        android:id="@+id/selection_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_gravity="bottom"
        android:background="@color/miui_card_background"
        android:elevation="12dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="42dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/selection_mark_read"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:drawableTop="@drawable/ic_check_vector"
            android:drawablePadding="3dp"
            android:gravity="center"
            android:text="@string/mark_as_read"
            android:textColor="@color/miui_primary_text"
            android:textSize="14sp"
            app:drawableTint="@color/miui_primary_text" />

        <TextView
            android:id="@+id/selection_delete"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:drawableTop="@drawable/ic_delete_vector"
            android:drawablePadding="3dp"
            android:gravity="center"
            android:text="@string/delete"
            android:textColor="@color/miui_primary_text"
            android:textSize="14sp"
            app:drawableTint="@color/miui_primary_text" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
