<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/miui_page_background">

    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/rules_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/miui_page_background">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/rules_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/miui_page_background"
            app:navigationIconTint="@color/miui_primary_text"
            app:title="@string/forwarding_rules_title"
            app:titleTextColor="@color/miui_primary_text" />
    </org.fossify.commons.views.MyAppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/rules_scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="32dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/rules_enabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:text="@string/forwarding_rules_enable"
                android:textColor="@color/miui_primary_text"
                android:textSize="17sp" />

            <TextView
                style="@style/SmsChannelHelperText"
                android:layout_marginTop="8dp"
                android:text="@string/forwarding_rules_scope_summary" />

            <View style="@style/SmsChannelDivider" />

            <TextView
                style="@style/SmsChannelSectionTitle"
                android:text="@string/forwarding_rules_list_title"
                android:textColor="@color/miui_primary_text" />

            <LinearLayout
                android:id="@+id/rules_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rules_add"
                    style="@style/SmsChannelSecondaryButton"
                    android:layout_width="0dp"
                    android:layout_marginTop="0dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text="@string/forwarding_rules_add" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rules_delete"
                    style="@style/SmsChannelSecondaryButton"
                    android:layout_width="0dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="0dp"
                    android:layout_weight="1"
                    android:text="@string/forwarding_rules_delete"
                    android:textColor="@color/miui_unread_red" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rules_move_up"
                    style="@style/SmsChannelSecondaryButton"
                    android:layout_width="0dp"
                    android:layout_marginTop="0dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text="@string/forwarding_rules_move_up" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rules_move_down"
                    style="@style/SmsChannelSecondaryButton"
                    android:layout_width="0dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="0dp"
                    android:layout_weight="1"
                    android:text="@string/forwarding_rules_move_down" />
            </LinearLayout>

            <TextView
                android:id="@+id/rules_last_decision"
                style="@style/SmsSettingsLogBox"
                android:layout_marginTop="10dp" />

            <View style="@style/SmsChannelDivider" />

            <TextView
                style="@style/SmsChannelSectionTitle"
                android:text="@string/forwarding_rules_section_scope"
                android:textColor="@color/miui_primary_text" />

            <TextView
                style="@style/SmsChannelFieldLabel"
                android:layout_marginTop="8dp"
                android:text="@string/forwarding_rules_scope" />

            <Spinner
                android:id="@+id/rules_scope"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/email_security_spinner_background"
                android:popupBackground="@color/miui_card_background"
                android:paddingHorizontal="12dp" />

            <TextView
                style="@style/SmsChannelFieldLabel"
                android:text="@string/forwarding_rules_sim_scope" />

            <Spinner
                android:id="@+id/rules_sim_scope"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/email_security_spinner_background"
                android:popupBackground="@color/miui_card_background"
                android:paddingHorizontal="12dp" />

            <View style="@style/SmsChannelDivider" />

            <TextView
                style="@style/SmsChannelSectionTitle"
                android:text="@string/forwarding_rules_editor_title"
                android:textColor="@color/miui_primary_text" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/forwarding_rules_name">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/rules_name"
                    style="@style/SmsChannelInputText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/rule_item_enabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="52dp"
                android:text="@string/forwarding_rules_item_enabled"
                android:textColor="@color/miui_primary_text" />

            <TextView
                style="@style/SmsChannelFieldLabel"
                android:text="@string/forwarding_rules_match_mode" />

            <Spinner
                android:id="@+id/rules_match_mode"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/email_security_spinner_background"
                android:popupBackground="@color/miui_card_background"
                android:paddingHorizontal="12dp" />

            <TextView
                style="@style/SmsChannelSectionTitle"
                android:layout_marginTop="16dp"
                android:text="@string/forwarding_rules_section_filter"
                android:textColor="@color/miui_primary_text" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/forwarding_rules_allow_keywords"
                app:helperText="@string/forwarding_rules_allow_keywords_helper"
                app:helperTextTextColor="@color/miui_secondary_text">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/rules_allow_keywords"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:minLines="2"
                    android:textColor="@color/miui_primary_text"
                    android:textColorHint="@color/miui_hint_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/forwarding_rules_exclude_keywords"
                app:helperText="@string/forwarding_rules_exclude_keywords_helper"
                app:helperTextTextColor="@color/miui_secondary_text">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/rules_exclude_keywords"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:minLines="2"
                    android:textColor="@color/miui_primary_text"
                    android:textColorHint="@color/miui_hint_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/forwarding_rules_allow_regex"
                app:helperText="@string/forwarding_rules_allow_regex_helper"
                app:helperTextTextColor="@color/miui_secondary_text">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/rules_allow_regex"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="@color/miui_primary_text"
                    android:textColorHint="@color/miui_hint_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/forwarding_rules_exclude_regex"
                app:helperText="@string/forwarding_rules_exclude_regex_helper"
                app:helperTextTextColor="@color/miui_secondary_text">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/rules_exclude_regex"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="@color/miui_primary_text"
                    android:textColorHint="@color/miui_hint_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/SmsChannelFieldLabel"
                android:text="@string/forwarding_rules_examples_title" />

            <TextView
                style="@style/SmsSettingsLogBox"
                android:layout_marginTop="6dp"
                android:text="@string/forwarding_rules_examples_body"
                android:textColor="@color/miui_primary_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rules_channels"
                style="@style/SmsChannelSecondaryButton"
                android:text="@string/forwarding_rules_channels" />

            <TextView
                android:id="@+id/rules_channels_summary"
                style="@style/SmsChannelHelperText"
                android:layout_marginTop="6dp" />

            <View style="@style/SmsChannelDivider" />

            <TextView
                style="@style/SmsChannelSectionTitle"
                android:text="@string/forwarding_rules_section_test"
                android:textColor="@color/miui_primary_text" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/forwarding_rules_test_body"
                app:helperText="@string/forwarding_rules_test_body_helper"
                app:helperTextTextColor="@color/miui_secondary_text">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/rules_test_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:minLines="2"
                    android:textColor="@color/miui_primary_text"
                    android:textColorHint="@color/miui_hint_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rules_test"
                style="@style/SmsChannelTestButton"
                android:text="@string/forwarding_rules_test" />

            <TextView
                android:id="@+id/rules_test_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/miui_primary_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rules_save"
                style="@style/SmsChannelSaveButton"
                android:text="@string/channel_save_config" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
