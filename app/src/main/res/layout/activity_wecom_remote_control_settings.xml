<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/miui_page_background">

    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/wecom_remote_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/miui_page_background">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/wecom_remote_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/miui_page_background"
            app:navigationIconTint="@color/miui_primary_text"
            app:title="@string/wecom_remote_title"
            app:titleTextColor="@color/miui_primary_text" />
    </org.fossify.commons.views.MyAppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/wecom_remote_scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/wecom_remote_enabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wecom_remote_enable"
                android:textColor="@color/miui_primary_text" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/wecom_remote_bot_id">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/wecom_remote_bot_id"
                    style="@style/SmsChannelInputText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/wecom_remote_secret"
                app:endIconMode="password_toggle"
                app:helperText="@string/wecom_remote_secret_hint"
                app:helperTextTextColor="@color/miui_secondary_text">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/wecom_remote_secret"
                    style="@style/SmsChannelInputText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/wecom_remote_chat_id"
                app:helperText="测试推送时使用的群聊 chatid 或成员 userid"
                app:helperTextTextColor="@color/miui_secondary_text">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/wecom_remote_chat_id"
                    style="@style/SmsChannelInputText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:id="@+id/wecom_remote_auto_chat_id_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/wecom_remote_auto_chat_id_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="12sp"
                    android:textColor="@color/brand_green"
                    android:text="💡 检测到最近会话: "
                    android:ellipsize="middle"
                    android:singleLine="true" />

                <Button
                    android:id="@+id/wecom_remote_auto_chat_id_btn"
                    style="@style/SmsChannelSecondaryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:paddingHorizontal="10dp"
                    android:textSize="11sp"
                    android:text="填入" />

                <Button
                    android:id="@+id/wecom_remote_copy_chat_id_btn"
                    style="@style/SmsChannelSecondaryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:paddingHorizontal="10dp"
                    android:textSize="11sp"
                    android:text="复制" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="自定义指令前缀 (选填，留空默认 /发信)"
                app:helperText="如自定义为 /发短信 或 #发信"
                app:helperTextTextColor="@color/miui_secondary_text">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/wecom_remote_custom_prefix"
                    style="@style/SmsChannelInputText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/SmsChannelFieldLabel"
                android:text="@string/dingtalk_remote_send_sim" />

            <Spinner
                android:id="@+id/wecom_remote_send_sim"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/email_security_spinner_background"
                android:popupBackground="@color/miui_card_background"
                android:paddingHorizontal="12dp" />

            <TextView
                style="@style/SmsChannelHelperText"
                android:layout_marginTop="8dp"
                android:text="@string/wecom_remote_format_hint" />

            <TextView
                style="@style/SmsChannelFieldLabel"
                android:text="@string/dingtalk_remote_examples_title" />

            <TextView
                style="@style/SmsSettingsLogBox"
                android:layout_marginTop="6dp"
                android:text="@string/dingtalk_remote_examples_body" />

            <TextView
                style="@style/SmsChannelFieldLabel"
                android:text="@string/dingtalk_remote_section_status" />

            <TextView
                android:id="@+id/wecom_remote_status"
                style="@style/SmsSettingsLogBox"
                android:layout_marginTop="6dp" />

            <TextView
                style="@style/SmsChannelFieldLabel"
                android:text="@string/remote_sms_section_log" />

            <TextView
                android:id="@+id/wecom_remote_logs"
                style="@style/SmsSettingsLogBox"
                android:layout_marginTop="6dp" />

            <Button
                android:id="@+id/wecom_remote_test"
                style="@style/SmsChannelSecondaryButton"
                android:layout_marginTop="16dp"
                android:text="@string/dingtalk_remote_test" />

            <Button
                android:id="@+id/wecom_remote_save"
                style="@style/SmsChannelPrimaryButton"
                android:layout_marginTop="8dp"
                android:text="@string/dingtalk_remote_save" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/settings_card_background"
                android:padding="14dp"
                android:textColor="@color/miui_secondary_text"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp"
                android:text="📌 企业微信智能机器人官方长连接配置指南：\n\n【入口 1：电脑端企业微信后台】\n1. 电脑端登录企业微信后台 (work.weixin.qq.com)，进入左侧菜单「安全与管理 → 管理工具」；\n2. 找到「智能专区」中的【智能机器人】，点击「创建智能机器人」；\n3. 模式选择【API模式】，连接方式勾选【使用长连接】（免域名/免公网IP）；\n4. 复制生成的 Bot ID，并点击获取 Secret 密钥。\n\n【入口 2：企业微信手机 App 直接创建】\n打开企业微信 App →「通讯录」→「智能机器人」→「创建智能机器人」→ 选择【API模式】并选择【使用长连接】。\n\n【使用方式】\n将 Bot ID 与 Secret 填入上方输入框并保存连接。将该机器人添加到企业群聊或发起单聊，在聊天框内发送：\n/发信 [SIM1|SIM2|默认] 手机号 短信内容\n即可直接驱动备用机发信，并原路接收发送状态及送达回执。" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>