<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/conversation_frame"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/miui_card_background"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="@dimen/conversation_min_height"
    android:paddingStart="@dimen/home_horizontal_margin"
    android:paddingTop="@dimen/conversation_vertical_padding"
    android:paddingEnd="@dimen/home_horizontal_margin"
    android:paddingBottom="0dp">

    <View
        android:id="@+id/unread_indicator"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:background="@drawable/unread_dot_background"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/conversation_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/conversation_image"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/conversation_image"
        android:layout_width="@dimen/conversation_avatar_size"
        android:layout_height="@dimen/conversation_avatar_size"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@id/conversation_body_short"
        app:layout_constraintStart_toEndOf="@id/unread_indicator"
        app:layout_constraintTop_toTopOf="@id/conversation_address"
        tools:src="@mipmap/ic_launcher" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/conversation_address"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/conversation_text_start_margin"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:textColor="@color/miui_primary_text"
        android:textDirection="locale"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@id/conversation_body_short"
        app:layout_constraintEnd_toStartOf="@id/conversation_date"
        app:layout_constraintStart_toEndOf="@id/conversation_image"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="John" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/draft_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/draft"
        android:textAlignment="viewStart"
        android:textColor="@color/color_primary"
        android:textDirection="locale"
        android:textSize="13sp"
        android:textStyle="italic"
        app:layout_constraintBottom_toBottomOf="@id/conversation_body_short"
        app:layout_constraintEnd_toStartOf="@id/conversation_body_short"
        app:layout_constraintStart_toStartOf="@id/conversation_address"
        app:layout_constraintTop_toTopOf="@id/conversation_body_short" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/conversation_body_short"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="@dimen/conversation_vertical_padding"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:textColor="@color/miui_secondary_text"
        android:textDirection="locale"
        android:textSize="13sp"
        app:layout_constraintBottom_toTopOf="@id/conversation_divider"
        app:layout_constraintEnd_toStartOf="@id/pin_indicator"
        app:layout_constraintStart_toEndOf="@id/draft_indicator"
        app:layout_constraintTop_toBottomOf="@id/conversation_address"
        tools:text="Hey buddy!" />

    <View
        android:id="@+id/conversation_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/miui_divider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/conversation_address" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/conversation_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:textAlignment="viewStart"
        android:textColor="@color/miui_timestamp_text"
        android:textDirection="locale"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/conversation_address"
        app:layout_constraintEnd_toStartOf="@id/conversation_selection_indicator"
        app:layout_constraintTop_toTopOf="@id/conversation_address"
        tools:text="13:30" />

    <ImageView
        android:id="@+id/pin_indicator"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:alpha="0.7"
        android:padding="2dp"
        android:src="@drawable/ic_pin_filled_vector"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/conversation_body_short"
        app:layout_constraintEnd_toStartOf="@id/unread_count_badge"
        app:layout_constraintTop_toTopOf="@id/conversation_body_short"
        tools:visibility="visible" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/unread_count_badge"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:minWidth="18dp"
        android:background="@drawable/unread_badge_background"
        android:gravity="center"
        android:includeFontPadding="false"
        android:paddingHorizontal="5dp"
        android:textSize="11sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/conversation_body_short"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/conversation_body_short"
        tools:text="42"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/conversation_selection_indicator"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:padding="4dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />
</androidx.constraintlayout.widget.ConstraintLayout>
