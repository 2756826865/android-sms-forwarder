<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/miui_page_background">

    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/compatibility_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/miui_page_background">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/compatibility_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/miui_page_background"
            app:navigationIconTint="@color/miui_primary_text"
            app:title="" />
    </org.fossify.commons.views.MyAppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/compatibility_scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="28dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="12dp"
                android:text="@string/compatibility_title"
                android:textColor="@color/miui_primary_text"
                android:textSize="28sp" />
            <TextView
                android:id="@+id/compatibility_device"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_marginBottom="20dp"
                android:textColor="@color/miui_secondary_text"
                android:textSize="14sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/settings_card_background"
                android:orientation="vertical"
                android:paddingVertical="4dp">
                <TextView android:id="@+id/compatibility_default_sms" style="@style/SmsSettingsRow" android:text="@string/compatibility_default_sms" />
                <View style="@style/SmsSettingsDivider" />
                <TextView android:id="@+id/compatibility_autostart" style="@style/SmsSettingsRow" android:text="@string/compatibility_autostart" />
                <View style="@style/SmsSettingsDivider" />
                <TextView android:id="@+id/compatibility_battery" style="@style/SmsSettingsRow" android:text="@string/compatibility_battery" />
                <View style="@style/SmsSettingsDivider" />
                <TextView android:id="@+id/compatibility_permissions" style="@style/SmsSettingsRow" android:text="@string/compatibility_permissions" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/settings_card_background"
                android:orientation="vertical"
                android:paddingVertical="4dp">
                <TextView
                    android:id="@+id/compatibility_refresh"
                    style="@style/SmsSettingsRow"
                    android:text="@string/compatibility_refresh" />
                <View style="@style/SmsSettingsDivider" />
                <TextView
                    android:id="@+id/compatibility_copy_fix"
                    style="@style/SmsSettingsRow"
                    android:text="@string/compatibility_copy_fix" />
                <View style="@style/SmsSettingsDivider" />
                <TextView
                    android:id="@+id/compatibility_project"
                    style="@style/SmsSettingsRow"
                    android:text="@string/compatibility_project" />
            </LinearLayout>
            <TextView
                android:id="@+id/compatibility_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="28dp"
                android:textColor="@color/miui_secondary_text"
                android:textSize="14sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
