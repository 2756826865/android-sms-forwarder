<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/miui_page_background">

    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/feishu_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/miui_page_background">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/feishu_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/miui_page_background"
            app:navigationIconTint="#111111"
            app:title="飞书群机器人" />
    </org.fossify.commons.views.MyAppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/feishu_scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/feishu_enabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="启用飞书群机器人转发"
                android:textColor="#111111" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Webhook 地址">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/feishu_webhook"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="签名密钥（可选）">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/feishu_secret"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/settings_card_background"
                android:padding="14dp"
                android:textColor="@color/miui_secondary_text"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp"
                android:text="📌 飞书群自定义机器人获取指南：\n1. 【电脑端操作】飞书移动端在群设置中默认隐藏了自定义机器人添加入口，请在电脑端（PC / Mac 桌面客户端）操作；\n2. 打开电脑端飞书群聊 → 点击右上角群设置 (...) →【群机器人】→【添加机器人】→ 选择【自定义机器人】；\n3. 复制生成的 Webhook 地址及可选的签名密钥填入上方；\n4. 【注意】本通道仅用于将短信、来电及低电量推送到飞书群；若需通过飞书发送指令让手机代发短信，请前往【远程控制 → 飞书 Stream】配置企业自建应用。" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="#E0E0E0" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="测试"
                android:textSize="18sp"
                android:textColor="#111111"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="测试发送方">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/feishu_test_sender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="测试短信正文">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/feishu_test_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:minLines="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/feishu_test"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="发送测试"
                android:backgroundTint="#159447" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/feishu_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="保存配置"
                android:backgroundTint="#111111" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="#E0E0E0" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="本功能仅用于个人合法用途，禁止用于骚扰、诈骗、垃圾短信等非法行为。违反者自行承担法律责任。"
                android:textColor="@color/miui_secondary_text"
                android:textSize="13sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
