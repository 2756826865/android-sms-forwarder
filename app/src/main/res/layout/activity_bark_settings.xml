<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/miui_page_background">

    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/bark_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/miui_page_background">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/bark_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/miui_page_background"
            app:navigationIconTint="#111111"
            app:title="@string/forwarding_bark"
            app:titleTextColor="#111111" />
    </org.fossify.commons.views.MyAppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/bark_scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/bark_enabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/bark_enable"
                android:textColor="#111111" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/bark_server_url"
                app:helperText="@string/bark_server_url_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/bark_server_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/bark_device_key">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/bark_device_key"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/bark_allow_http"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/bark_allow_http"
                android:textColor="#111111" />

            <View style="@style/SmsChannelDivider" />

            <TextView
                style="@style/SmsChannelSectionTitle"
                android:text="@string/channel_section_test" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/bark_test_sender">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/bark_test_sender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/bark_test_body">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/bark_test_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences|textMultiLine"
                    android:minLines="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bark_test"
                style="@style/SmsChannelTestButton"
                android:text="@string/channel_test_send" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bark_save"
                style="@style/SmsChannelSaveButton"
                android:text="@string/channel_save_config" />

            <View style="@style/SmsChannelDivider" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/channel_legal_notice"
                android:textColor="#999999"
                android:textSize="11sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
