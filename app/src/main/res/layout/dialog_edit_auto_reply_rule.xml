<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="规则名称"
            android:textColor="@color/miui_primary_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/dialog_rule_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="例如：10086 自动办业务回复Y"
            android:textColor="@color/miui_primary_text"
            android:textColorHint="@color/miui_hint_text"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="发件人号码匹配 (留空则匹配所有号码)"
            android:textColor="@color/miui_primary_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/dialog_rule_sender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="例如：10086 或 106, 955 (逗号分隔)"
            android:textColor="@color/miui_primary_text"
            android:textColorHint="@color/miui_hint_text"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="包含关键词 (逗号分隔，满足任一触发)"
            android:textColor="@color/miui_primary_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/dialog_rule_keywords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="例如：回复Y, 确认, 办业务"
            android:textColor="@color/miui_primary_text"
            android:textColorHint="@color/miui_hint_text"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="排除关键词 (包含则不触发)"
            android:textColor="@color/miui_primary_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/dialog_rule_exclude"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="例如：退订, 失败"
            android:textColor="@color/miui_primary_text"
            android:textColorHint="@color/miui_hint_text"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="自动回复短信内容"
            android:textColor="@color/miui_primary_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/dialog_rule_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="top"
            android:hint="例如：Y"
            android:minLines="2"
            android:textColor="@color/miui_primary_text"
            android:textColorHint="@color/miui_hint_text"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="同号码冷却时间 (可自定义 1分钟 到 任意天数)"
            android:textColor="@color/miui_primary_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/dialog_rule_cooldown_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="输入数值 (如 1, 30, 24)"
                android:inputType="number"
                android:text="24"
                android:textColor="@color/miui_primary_text"
                android:textColorHint="@color/miui_hint_text"
                android:textSize="15sp" />

            <Spinner
                android:id="@+id/dialog_rule_cooldown_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="回复发信卡槽"
            android:textColor="@color/miui_primary_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/dialog_rule_sim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

    </LinearLayout>
</ScrollView>
