<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/thread_date_time_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:layout_marginBottom="4dp">

    <LinearLayout
        android:id="@+id/thread_date_time_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/thread_sim_holder"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="5dp">

            <ImageView
                android:id="@+id/thread_sim_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_sim_vector" />

            <TextView
                android:id="@+id/thread_sim_number"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="2" />
        </FrameLayout>

        <TextView
            android:id="@+id/thread_date_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/miui_secondary_text"
            android:textSize="12sp"
            tools:text="12:54" />
    </LinearLayout>
</RelativeLayout>
