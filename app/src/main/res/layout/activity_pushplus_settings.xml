<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/miui_page_background">

    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/pushplus_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/miui_page_background">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/pushplus_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/miui_page_background"
            app:navigationIconTint="@color/miui_primary_text"
            app:title="@string/pushplus_forwarding"
            app:titleTextColor="@color/miui_primary_text" />
    </org.fossify.commons.views.MyAppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/pushplus_scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <org.fossify.commons.views.MyMaterialSwitch
                android:id="@+id/pushplus_enabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pushplus_enable" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/pushplus_token"
                app:endIconMode="password_toggle"
                app:helperText="@string/pushplus_token_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/pushplus_token"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/pushplus_title_prefix">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/pushplus_title_prefix"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <CheckBox
                android:id="@+id/pushplus_include_sender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/pushplus_include_sender" />

            <CheckBox
                android:id="@+id/pushplus_include_sim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pushplus_include_sim" />

            <CheckBox
                android:id="@+id/pushplus_include_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pushplus_include_time" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pushplus_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/pushplus_save"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/miui_fab_green" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/pushplus_test_sender">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/pushplus_test_sender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/pushplus_test_body">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/pushplus_test_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="4" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pushplus_test"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/pushplus_test_custom"
                android:textColor="@color/miui_primary_text"
                app:strokeColor="@color/miui_secondary_text" />

            <TextView
                android:id="@+id/pushplus_diagnostics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/home_search_background"
                android:padding="14dp"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/pushplus_last_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/miui_secondary_text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:alpha="1"
                android:text="@string/pushplus_privacy_note"
                android:textColor="@color/miui_secondary_text" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
