<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/miui_page_background">

    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/remote_forwarding_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/miui_page_background">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/remote_forwarding_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/miui_page_background"
            app:navigationIconTint="@color/miui_primary_text"
            app:title=""
            app:titleTextColor="@color/miui_primary_text" />
    </org.fossify.commons.views.MyAppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/remote_forwarding_scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="28dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="sans-serif"
                android:text="@string/remote_forwarding_title"
                android:textColor="@color/miui_primary_text"
                android:textSize="38sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="24dp"
                android:text="@string/remote_forwarding_intro"
                android:textColor="@color/miui_secondary_text"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="8dp"
                android:text="@string/remote_forwarding_channels_section"
                android:textColor="@color/miui_section_text"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/settings_card_background"
                android:orientation="vertical"
                android:paddingVertical="4dp">

                <LinearLayout
                    android:id="@+id/remote_forwarding_sms_holder"
                    style="@style/SmsForwardingRow">

                    <LinearLayout style="@style/SmsForwardingTextColumn">
                        <TextView
                            style="@style/SmsForwardingTitle"
                            android:text="@string/remote_sms_title" />

                        <TextView
                            android:id="@+id/remote_forwarding_sms_summary"
                            style="@style/SmsForwardingSummary" />
                    </LinearLayout>

                    <ImageView style="@style/SmsForwardingChevron" />
                </LinearLayout>

                <View style="@style/SmsSettingsDivider" />

                <LinearLayout
                    android:id="@+id/remote_forwarding_dingtalk_holder"
                    style="@style/SmsForwardingRow">

                    <LinearLayout style="@style/SmsForwardingTextColumn">
                        <TextView
                            style="@style/SmsForwardingTitle"
                            android:text="@string/dingtalk_remote_title" />

                        <TextView
                            android:id="@+id/remote_forwarding_dingtalk_summary"
                            style="@style/SmsForwardingSummary" />
                    </LinearLayout>

                    <ImageView style="@style/SmsForwardingChevron" />
                </LinearLayout>

                <View style="@style/SmsSettingsDivider" />

                <LinearLayout
                    android:id="@+id/remote_forwarding_feishu_holder"
                    style="@style/SmsForwardingRow">

                    <LinearLayout style="@style/SmsForwardingTextColumn">
                        <TextView
                            style="@style/SmsForwardingTitle"
                            android:text="@string/feishu_remote_title" />

                        <TextView
                            android:id="@+id/remote_forwarding_feishu_summary"
                            style="@style/SmsForwardingSummary" />
                    </LinearLayout>

                    <ImageView style="@style/SmsForwardingChevron" />
                </LinearLayout>

                <View style="@style/SmsSettingsDivider" />

                <LinearLayout
                    android:id="@+id/remote_forwarding_wecom_holder"
                    style="@style/SmsForwardingRow">

                    <LinearLayout style="@style/SmsForwardingTextColumn">
                        <TextView
                            style="@style/SmsForwardingTitle"
                            android:text="@string/wecom_remote_title" />

                        <TextView
                            android:id="@+id/remote_forwarding_wecom_summary"
                            style="@style/SmsForwardingSummary" />
                    </LinearLayout>

                    <ImageView style="@style/SmsForwardingChevron" />
                </LinearLayout>

                <View style="@style/SmsSettingsDivider" />

                <LinearLayout
                    android:id="@+id/remote_forwarding_email_holder"
                    style="@style/SmsForwardingRow">

                    <LinearLayout style="@style/SmsForwardingTextColumn">
                        <TextView
                            style="@style/SmsForwardingTitle"
                            android:text="@string/email_remote_title" />

                        <TextView
                            android:id="@+id/remote_forwarding_email_summary"
                            style="@style/SmsForwardingSummary" />
                    </LinearLayout>

                    <ImageView style="@style/SmsForwardingChevron" />
                </LinearLayout>

                <View style="@style/SmsSettingsDivider" />

                <LinearLayout
                    android:id="@+id/remote_forwarding_telegram_holder"
                    style="@style/SmsForwardingRow">

                    <LinearLayout style="@style/SmsForwardingTextColumn">
                        <TextView
                            style="@style/SmsForwardingTitle"
                            android:text="@string/telegram_remote_title" />

                        <TextView
                            android:id="@+id/remote_forwarding_telegram_summary"
                            style="@style/SmsForwardingSummary" />
                    </LinearLayout>

                    <ImageView style="@style/SmsForwardingChevron" />
                </LinearLayout>

                <View style="@style/SmsSettingsDivider" />

                <LinearLayout
                    android:id="@+id/remote_forwarding_websocket_holder"
                    style="@style/SmsForwardingRow">

                    <LinearLayout style="@style/SmsForwardingTextColumn">
                        <TextView
                            style="@style/SmsForwardingTitle"
                            android:text="@string/websocket_remote_title" />

                        <TextView
                            android:id="@+id/remote_forwarding_websocket_summary"
                            style="@style/SmsForwardingSummary" />
                    </LinearLayout>

                    <ImageView style="@style/SmsForwardingChevron" />
                </LinearLayout>

                <View style="@style/SmsSettingsDivider" />

                <LinearLayout
                    android:id="@+id/remote_forwarding_qq_holder"
                    style="@style/SmsForwardingRow">

                    <LinearLayout style="@style/SmsForwardingTextColumn">
                        <TextView
                            style="@style/SmsForwardingTitle"
                            android:text="@string/qq_remote_title" />

                        <TextView
                            android:id="@+id/remote_forwarding_qq_summary"
                            style="@style/SmsForwardingSummary" />
                    </LinearLayout>

                    <ImageView style="@style/SmsForwardingChevron" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
