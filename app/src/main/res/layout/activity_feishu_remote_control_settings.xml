<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/miui_page_background">

    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/feishu_remote_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/miui_page_background">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/feishu_remote_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/miui_page_background"
            app:navigationIconTint="@color/miui_primary_text"
            app:title="@string/feishu_remote_title"
            app:titleTextColor="@color/miui_primary_text" />
    </org.fossify.commons.views.MyAppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/feishu_remote_scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/feishu_remote_enabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/feishu_remote_enable"
                android:textColor="@color/miui_primary_text" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/feishu_remote_app_id">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/feishu_remote_app_id"
                    style="@style/SmsChannelInputText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/feishu_remote_app_secret"
                app:endIconMode="password_toggle"
                app:helperText="@string/dingtalk_remote_secret_hint"
                app:helperTextTextColor="@color/miui_secondary_text">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/feishu_remote_app_secret"
                    style="@style/SmsChannelInputText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="自定义指令前缀 (选填，留空默认 /发信)"
                app:helperText="如自定义为 /发短信 或 #发信"
                app:helperTextTextColor="@color/miui_secondary_text">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/feishu_remote_custom_prefix"
                    style="@style/SmsChannelInputText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/SmsChannelFieldLabel"
                android:text="@string/dingtalk_remote_send_sim" />

            <Spinner
                android:id="@+id/feishu_remote_send_sim"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/email_security_spinner_background"
                android:popupBackground="@color/miui_card_background"
                android:paddingHorizontal="12dp" />

            <TextView
                style="@style/SmsChannelHelperText"
                android:layout_marginTop="8dp"
                android:text="@string/dingtalk_remote_format_hint" />

            <TextView
                style="@style/SmsChannelFieldLabel"
                android:text="@string/dingtalk_remote_examples_title" />

            <TextView
                style="@style/SmsSettingsLogBox"
                android:layout_marginTop="6dp"
                android:text="@string/dingtalk_remote_examples_body" />

            <TextView
                style="@style/SmsChannelFieldLabel"
                android:text="@string/dingtalk_remote_section_status" />

            <TextView
                android:id="@+id/feishu_remote_status"
                style="@style/SmsSettingsLogBox"
                android:layout_marginTop="6dp" />

            <TextView
                style="@style/SmsChannelFieldLabel"
                android:text="@string/remote_sms_section_log" />

            <TextView
                android:id="@+id/feishu_remote_logs"
                style="@style/SmsSettingsLogBox"
                android:layout_marginTop="6dp" />

            <Button
                android:id="@+id/feishu_remote_test"
                style="@style/SmsChannelSecondaryButton"
                android:layout_marginTop="16dp"
                android:text="@string/dingtalk_remote_test" />

            <Button
                android:id="@+id/feishu_remote_save"
                style="@style/SmsChannelPrimaryButton"
                android:layout_marginTop="8dp"
                android:text="@string/dingtalk_remote_save" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/settings_card_background"
                android:padding="14dp"
                android:textColor="@color/miui_secondary_text"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp"
                android:text="📌 飞书开放平台长连接配置注意事项：\n1. 【创建自建应用】在飞书开放平台 (open.feishu.cn) 创建企业应用，在「凭证与基础信息」中获取 App ID 与 App Secret；\n2. 【开启机器人能力】在「应用能力 → 机器人」中开通机器人；\n3. 【事件配置（关键）】在「开发配置 → 事件与回调」中，进入【事件配置】Tab（切勿选成回调配置！）：\n   • 订阅方式选择「使用长连接接收事件」；\n   • 点击「添加事件」，勾选「接收消息 v2.0」(im.message.receive_v1)；\n4. 【长连接验证】手机端填好 App ID/Secret 并点击【保存并连接】，待状态显示「已连接」后，再前往飞书后台点击「重新验证/保存」；\n5. 【群聊远程发信】在电脑端将该自建应用拉入群聊，在群内 @机器人 /发信 10086 查询 即可真实发信。" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>