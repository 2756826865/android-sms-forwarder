<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/miui_page_background">

    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/forwarding_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/miui_page_background">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/forwarding_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/miui_page_background"
            app:navigationIconTint="@color/miui_primary_text"
            app:title="" />
    </org.fossify.commons.views.MyAppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/forwarding_scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="28dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="30dp"
                android:fontFamily="sans-serif"
                android:text="@string/forwarding_title"
                android:textColor="@color/miui_primary_text"
                android:textSize="38sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif"
                android:text="@string/forwarding_channels"
                android:textColor="@color/miui_section_text"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/settings_card_background"
                android:orientation="vertical"
                android:paddingVertical="4dp">

                <LinearLayout
                    android:id="@+id/forwarding_pushplus_holder"
                    style="@style/SmsForwardingRow">
                    <LinearLayout style="@style/SmsForwardingTextColumn">
                        <TextView style="@style/SmsForwardingTitle" android:text="@string/forwarding_pushplus" />
                        <TextView android:id="@+id/forwarding_pushplus_summary" style="@style/SmsForwardingSummary" />
                    </LinearLayout>
                    <ImageView style="@style/SmsForwardingChevron" />
                </LinearLayout>

                <View style="@style/SmsSettingsDivider" />

                <LinearLayout
                    android:id="@+id/forwarding_dingtalk_holder"
                    style="@style/SmsForwardingRow">
                    <LinearLayout style="@style/SmsForwardingTextColumn">
                        <TextView style="@style/SmsForwardingTitle" android:text="@string/forwarding_dingtalk" />
                        <TextView android:id="@+id/forwarding_dingtalk_summary" style="@style/SmsForwardingSummary" />
                    </LinearLayout>
                    <ImageView style="@style/SmsForwardingChevron" />
                </LinearLayout>

                <View style="@style/SmsSettingsDivider" />

                <LinearLayout
                    android:id="@+id/forwarding_feishu_holder"
                    style="@style/SmsForwardingRow">
                    <LinearLayout style="@style/SmsForwardingTextColumn">
                        <TextView style="@style/SmsForwardingTitle" android:text="@string/forwarding_feishu" />
                        <TextView android:id="@+id/forwarding_feishu_summary" style="@style/SmsForwardingSummary" />
                    </LinearLayout>
                    <ImageView style="@style/SmsForwardingChevron" />
                </LinearLayout>

                <View style="@style/SmsSettingsDivider" />

                <LinearLayout
                    android:id="@+id/forwarding_wecom_holder"
                    style="@style/SmsForwardingRow">
                    <LinearLayout style="@style/SmsForwardingTextColumn">
                        <TextView style="@style/SmsForwardingTitle" android:text="@string/forwarding_wecom" />
                        <TextView android:id="@+id/forwarding_wecom_summary" style="@style/SmsForwardingSummary" />
                    </LinearLayout>
                    <ImageView style="@style/SmsForwardingChevron" />
                </LinearLayout>

                <View style="@style/SmsSettingsDivider" />

                <LinearLayout
                    android:id="@+id/forwarding_email_holder"
                    style="@style/SmsForwardingRow">
                    <LinearLayout style="@style/SmsForwardingTextColumn">
                        <TextView style="@style/SmsForwardingTitle" android:text="@string/forwarding_email" />
                        <TextView android:id="@+id/forwarding_email_summary" style="@style/SmsForwardingSummary" />
                    </LinearLayout>
                    <ImageView style="@style/SmsForwardingChevron" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="@string/forwarding_display"
                android:textColor="@color/miui_section_text"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/settings_card_background"
                android:orientation="vertical"
                android:paddingVertical="4dp">

                <LinearLayout android:id="@+id/forwarding_sim_one_holder" style="@style/SmsForwardingRow">
                    <LinearLayout style="@style/SmsForwardingTextColumn">
                        <TextView style="@style/SmsForwardingTitle" android:text="@string/forwarding_sim_one_label" />
                        <TextView android:id="@+id/forwarding_sim_one_summary" style="@style/SmsForwardingSummary" />
                    </LinearLayout>
                    <ImageView style="@style/SmsForwardingChevron" />
                </LinearLayout>

                <View style="@style/SmsSettingsDivider" />

                <LinearLayout android:id="@+id/forwarding_sim_two_holder" style="@style/SmsForwardingRow">
                    <LinearLayout style="@style/SmsForwardingTextColumn">
                        <TextView style="@style/SmsForwardingTitle" android:text="@string/forwarding_sim_two_label" />
                        <TextView android:id="@+id/forwarding_sim_two_summary" style="@style/SmsForwardingSummary" />
                    </LinearLayout>
                    <ImageView style="@style/SmsForwardingChevron" />
                </LinearLayout>

                <View style="@style/SmsSettingsDivider" />

                <LinearLayout android:id="@+id/forwarding_template_holder" style="@style/SmsForwardingRow">
                    <LinearLayout style="@style/SmsForwardingTextColumn">
                        <TextView style="@style/SmsForwardingTitle" android:text="@string/forwarding_template" />
                        <TextView android:id="@+id/forwarding_template_summary" style="@style/SmsForwardingSummary" />
                    </LinearLayout>
                    <ImageView style="@style/SmsForwardingChevron" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/forwarding_disclaimer_holder"
                style="@style/SmsForwardingRow"
                android:layout_marginTop="18dp"
                android:background="@drawable/settings_card_background">
                <LinearLayout style="@style/SmsForwardingTextColumn">
                    <TextView style="@style/SmsForwardingTitle" android:text="@string/forwarding_disclaimer_title" />
                    <TextView style="@style/SmsForwardingSummary" android:text="@string/forwarding_disclaimer_summary" />
                </LinearLayout>
                <ImageView style="@style/SmsForwardingChevron" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/forwarding_test"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="22dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/forwarding_test_all"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/miui_fab_green"
                app:cornerRadius="27dp" />

            <TextView
                android:id="@+id/forwarding_last_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif"
                android:textColor="@color/miui_secondary_text"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="20dp"
                android:fontFamily="sans-serif"
                android:text="@string/forwarding_privacy_note"
                android:textColor="@color/miui_secondary_text"
                android:textSize="13sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
