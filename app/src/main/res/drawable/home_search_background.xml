<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/miui_card_background" />
            <stroke android:width="1dp" android:color="@color/miui_action_blue" />
            <corners android:radius="@dimen/home_search_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/miui_search_background" />
            <stroke android:width="1dp" android:color="@color/miui_search_stroke" />
            <corners android:radius="@dimen/home_search_radius" />
        </shape>
    </item>
</selector>
