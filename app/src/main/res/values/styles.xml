<resources>

    <style name="AppTheme" parent="AppTheme.Base">
        <item name="android:alertDialogTheme">@style/SmsAlertDialogTheme</item>
        <item name="alertDialogTheme">@style/SmsAlertDialogTheme</item>
        <item name="colorPrimary">@color/miui_action_blue</item>
        <item name="android:colorPrimary">@color/miui_action_blue</item>
        <item name="colorAccent">@color/miui_fab_green</item>
        <item name="android:colorAccent">@color/miui_fab_green</item>
        <item name="actionModeBackground">@color/miui_action_blue</item>
        <item name="android:actionModeBackground">@color/miui_action_blue</item>
        <item name="windowActionModeOverlay">true</item>
    </style>

    <style name="ThreadTheme" parent="AppTheme" xmlns:tools="http://schemas.android.com/tools">
        <item name="android:windowBackground">@color/classic_settings_background</item>
        <item name="android:colorBackground">@color/classic_settings_background</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
    </style>

    <style name="SmsAlertDialogTheme" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="android:textColorPrimary">@color/miui_primary_text</item>
        <item name="android:textColorSecondary">@color/miui_secondary_text</item>
        <item name="android:colorAccent">@color/miui_fab_green</item>
        <item name="colorAccent">@color/miui_fab_green</item>
    </style>

    <style name="SmsThreadToolbarTitleText" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/miui_primary_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="SmsThreadToolbarSubtitleText" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/miui_secondary_text</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="SmsSettingsRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:drawableEnd">@drawable/ic_chevron_right_vector</item>
        <item name="android:drawableTint">@color/classic_icon_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:paddingVertical">14dp</item>
        <item name="android:textColor">@color/classic_text_primary</item>
        <item name="android:textSize">17sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="SmsSettingsDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">20dp</item>
        <item name="android:background">@color/classic_divider</item>
    </style>

    <style name="SmsForwardingRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">78dp</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingHorizontal">20dp</item>
    </style>

    <style name="SmsForwardingTextColumn">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="SmsForwardingTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/miui_primary_text</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="SmsForwardingSummary">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/miui_secondary_text</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="SmsForwardingChevron">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:src">@drawable/ic_chevron_right_vector</item>
    </style>

    <style name="SmsSettingsSectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">20dp</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:textColor">@color/classic_text_secondary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SmsChannelSectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/miui_primary_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SmsChannelFieldLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textColor">@color/miui_primary_text</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="SmsChannelHelperText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingHorizontal">4dp</item>
        <item name="android:textColor">@color/miui_secondary_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="SmsChannelInputText">
        <item name="android:textColor">@color/miui_primary_text</item>
        <item name="android:textColorHint">@color/miui_hint_text</item>
    </style>

    <style name="SmsChannelDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginVertical">16dp</item>
        <item name="android:background">@color/miui_divider</item>
    </style>

    <style name="SmsChannelTestButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="cornerRadius">8dp</item>
        <item name="backgroundTint">@color/miui_action_blue</item>
    </style>

    <style name="SmsChannelSaveButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="cornerRadius">8dp</item>
        <item name="backgroundTint">@color/sms_save_button_bg</item>
    </style>

    <style name="SmsChannelPrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="cornerRadius">8dp</item>
        <item name="backgroundTint">@color/sms_save_button_bg</item>
    </style>

    <style name="SmsChannelSecondaryButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/miui_primary_text</item>
        <item name="cornerRadius">8dp</item>
        <item name="strokeColor">@color/bulk_outline</item>
    </style>

    <style name="SmsSettingsFormCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/settings_card_background</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="SmsSettingsPrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">27dp</item>
        <item name="backgroundTint">@color/miui_fab_green</item>
    </style>

    <style name="SmsSettingsOutlinedButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:textColor">@color/miui_primary_text</item>
        <item name="cornerRadius">27dp</item>
        <item name="strokeColor">@color/miui_secondary_text</item>
    </style>

    <style name="SmsSettingsLogBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/home_search_background</item>
        <item name="android:padding">14dp</item>
        <item name="android:textColor">@color/miui_primary_text</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="CompatibilitySectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_marginTop">22dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:textColor">@color/miui_section_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CompatibilityCheckRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">88dp</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:paddingVertical">14dp</item>
    </style>

    <style name="CompatibilityStatusText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:gravity">end</item>
        <item name="android:maxWidth">104dp</item>
        <item name="android:maxLines">2</item>
        <item name="android:textColor">@color/miui_secondary_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="roundedImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/normal_margin</item>
    </style>

    <style name="CircularFabShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
